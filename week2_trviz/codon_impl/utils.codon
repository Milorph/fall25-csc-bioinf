# codon_impl/utils.codon
# Codon port of TRviz utils.py (no numpy/Bio dependencies)
# - FASTA parsing implemented manually
# - Simulated annealing uses standard math/random
# - All functions mirror original names & behavior

from typing import List, Dict, Tuple
import math
import random

# --------------------------------------------------------------------
# Constants & alphabets
# --------------------------------------------------------------------
LOWERCASE_LETTERS: List[str] = [chr(i) for i in range(ord('a'), ord('z') + 1)]
UPPERCASE_LETTERS: List[str] = [chr(i) for i in range(ord('A'), ord('Z') + 1)]
DIGITS: List[str] = [chr(i) for i in range(ord('0'), ord('9') + 1)]

skipping_characters: List[str] = ['(', '=', '<', '>', '?', '-']
PRIVATE_MOTIF_LABEL: str = '?'

INDEX_TO_CHR: List[str] = []
# start with letters and digits
for ch in LOWERCASE_LETTERS:
    INDEX_TO_CHR.append(ch)
for ch in UPPERCASE_LETTERS:
    if ch not in INDEX_TO_CHR:
        INDEX_TO_CHR.append(ch)
for ch in DIGITS:
    if ch not in INDEX_TO_CHR:
        INDEX_TO_CHR.append(ch)
# extend with printable ASCII 33..126 excluding skips & duplicates
code = 33
while code < 127:
    ch = chr(code)
    if (ch not in skipping_characters) and (ch not in INDEX_TO_CHR):
        INDEX_TO_CHR.append(ch)
    code += 1

DNA_CHARACTERS = {'A', 'C', 'G', 'T'}

# --------------------------------------------------------------------
# FASTA & counters
# --------------------------------------------------------------------
def get_sample_and_sequence_from_fasta(fasta_file: str) -> Tuple[List[str], List[str]]:
    """
    Read FASTA file and return (headers, sequences) with sequences uppercased.
    Minimal parser (no BioPython dependency).
    """
    headers: List[str] = []
    sequences: List[str] = []
    cur_id = ""
    cur_seq = []
    with open(fasta_file) as f:
        for raw in f:
            line = raw.strip()
            if not line:
                continue
            if line[0] == '>':
                # flush previous
                if cur_id != "":
                    headers.append(cur_id)
                    sequences.append("".join(cur_seq).upper())
                    cur_seq = []
                cur_id = line[1:].split()[0]
            else:
                cur_seq.append(line)
        # flush tail
        if cur_id != "":
            headers.append(cur_id)
            sequences.append("".join(cur_seq).upper())
    return headers, sequences

def get_motif_counter(decomposed_vntrs: List[List[str]]) -> Dict[str, int]:
    """Return a dict counting each motif across all decomposed VNTRs."""
    motif_counter: Dict[str, int] = {}
    i = 0
    while i < len(decomposed_vntrs):
        vntr = decomposed_vntrs[i]
        j = 0
        while j < len(vntr):
            m = vntr[j]
            motif_counter[m] = motif_counter.get(m, 0) + 1
            j += 1
        i += 1
    return motif_counter

# --------------------------------------------------------------------
# HMM/state helpers
# --------------------------------------------------------------------
def is_emitting_state(state_name: str) -> bool:
    """True if insertion/match/start_random_matches/end_random_matches."""
    return (
        state_name.startswith('M') or
        state_name.startswith('I') or
        state_name.startswith('start_random_matches') or
        state_name.startswith('end_random_matches')
    )

def get_repeating_pattern_lengths(visited_states: List[str]) -> List[int]:
    """
    Count the number of emitting states between unit_start .. unit_end windows.
    """
    lengths: List[int] = []
    prev_start: int = -1
    i = 0
    while i < len(visited_states):
        s = visited_states[i]
        if s.startswith('unit_end') and prev_start != -1:
            current_len = 0
            j = prev_start
            while j < i:
                if is_emitting_state(visited_states[j]):
                    current_len += 1
                j += 1
            lengths.append(current_len)
        if s.startswith('unit_start'):
            prev_start = i
        i += 1
    return lengths

def get_motifs_from_visited_states_and_region(visited_states: List[str], region: str) -> List[str]:
    """
    Slice 'region' into motif strings according to emitting-length windows.
    """
    lengths = get_repeating_pattern_lengths(visited_states)
    repeat_segments: List[str] = []
    added = 0
    for L in lengths:
        repeat_segments.append(region[added:added + L])
        added += L
    return repeat_segments

# --------------------------------------------------------------------
# DNA validation
# --------------------------------------------------------------------
def is_valid_sequence(sequence: str) -> bool:
    """Check if the given sequence is DNA (A/C/G/T)."""
    for s in sequence:
        if s not in DNA_CHARACTERS:
            return False
    return True

# --------------------------------------------------------------------
# Sorting / ordering of aligned encodings
# --------------------------------------------------------------------
def sort_by_manually(aligned_vntrs: List[str], sample_ids: List[str], sample_order_file: str) -> Tuple[List[str], List[str]]:
    """Sort aligned encodings by order listed in a file (one ID per line)."""
    if sample_order_file is None or sample_order_file == "":
        print("Sample order file is not provided. Follow the given sample order.")
        return sample_ids, aligned_vntrs

    with open(sample_order_file) as f:
        sample_order = [line.strip() for line in f.readlines() if line.strip() != ""]

    sorted_ids: List[str] = []
    sorted_vntrs: List[str] = []
    k = 0
    while k < len(sample_order):
        sid = sample_order[k]
        # if present, append in that order
        idx = -1
        i = 0
        while i < len(sample_ids):
            if sample_ids[i] == sid:
                idx = i
                break
            i += 1
        if idx != -1:
            sorted_ids.append(sample_ids[idx])
            sorted_vntrs.append(aligned_vntrs[idx])
        k += 1
    return sorted_ids, sorted_vntrs

def _strip_gaps_len(s: str) -> int:
    cnt = 0
    for ch in s:
        if ch != '-':
            cnt += 1
    return cnt

def sort(
    aligned_vntrs: List[str],
    sample_ids: List[str],
    symbol_to_motif: Dict[str, str],
    sample_order_file: str,
    method: str = 'motif_count'
) -> Tuple[List[str], List[str]]:
    """
    Sort aligned encodings and IDs using one of:
      - 'name'               : lexicographic by sample_id
      - 'motif_count'        : by number of non-gap symbols (desc)
      - 'simulated_annealing': heuristic cost-based order
      - 'manually'           : from file order
    """
    if method == 'name':
        pairs: List[Tuple[str, str]] = []
        i = 0
        while i < len(sample_ids):
            pairs.append((sample_ids[i], aligned_vntrs[i]))
            i += 1
        pairs.sort(key=lambda kv: kv[0])
        out_ids: List[str] = []
        out_v: List[str] = []
        for sid, v in pairs:
            out_ids.append(sid)
            out_v.append(v)
        return out_ids, out_v

    elif method == 'motif_count':
        pairs: List[Tuple[int, int, str, str]] = []
        i = 0
        while i < len(sample_ids):
            count = _strip_gaps_len(aligned_vntrs[i])
            # sort by (-count, sample_id) to be deterministic
            pairs.append((-count, 0, sample_ids[i], aligned_vntrs[i]))
            i += 1
        pairs.sort()
        out_ids: List[str] = []
        out_v: List[str] = []
        i = 0
        while i < len(pairs):
            _neg, _zero, sid, v = pairs[i]
            out_ids.append(sid)
            out_v.append(v)
            i += 1
        return out_ids, out_v

    elif method == 'simulated_annealing':
        return sort_by_simulated_annealing_optimized(aligned_vntrs, sample_ids, symbol_to_motif)

    elif method == 'manually':
        return sort_by_manually(aligned_vntrs, sample_ids, sample_order_file)

    else:
        raise ValueError("Please check the rearrangement method. " + method)

# --------------------------------------------------------------------
# Distances & costs
# --------------------------------------------------------------------
def get_levenshtein_distance(s1: str, s2: str) -> int:
    """Classic Levenshtein distance (insert/delete/substitute)."""
    # ensure s1 is the shorter
    if len(s1) > len(s2):
        t = s1
        s1 = s2
        s2 = t
    n = len(s1)
    m = len(s2)
    # initialize previous row
    prev: List[int] = [i for i in range(n + 1)]
    j = 1
    while j <= m:
        c2 = s2[j-1]
        cur: List[int] = [j]
        i = 1
        while i <= n:
            c1 = s1[i-1]
            if c1 == c2:
                cur.append(prev[i-1])
            else:
                a = prev[i-1] + 1   # substitute
                b = prev[i] + 1     # delete from s1
                c = cur[i-1] + 1    # insert into s1
                # min of a,b,c
                best = a if a <= b else b
                if c < best:
                    best = c
                cur.append(best)
            i += 1
        prev = cur
        j += 1
    return prev[-1]

def _calculate_cost(seq1: str, seq2: str, alphabet_to_motif: Dict[str, str]) -> int:
    if len(seq1) != len(seq2):
        raise Exception("The length of two sequences should be identical.")
    cost = 0
    i = 0
    while i < len(seq1):
        a = seq1[i]
        b = seq2[i]
        if a != b:
            if a != '-' and b != '-':
                s1 = alphabet_to_motif[a.lower()]
                s2 = alphabet_to_motif[b.lower()]
                cost += get_levenshtein_distance(s1, s2)
            else:
                if a == '-':
                    cost += len(alphabet_to_motif[b.lower()])
                else:
                    cost += len(alphabet_to_motif[a.lower()])
        i += 1
    return cost

def calculate_cost_with_dist_matrix(
    aligned_encoded_vntr1: str,
    aligned_encoded_vntr2: str,
    dist_matrix: Dict[str, Dict[str, float]],
    allow_copy_change: bool = False
) -> float:
    if len(aligned_encoded_vntr1) != len(aligned_encoded_vntr2):
        raise Exception("The length of two sequences should be identical.")
    cost: float = 0.0
    i = 0
    while i < len(aligned_encoded_vntr1):
        s1 = aligned_encoded_vntr1[i]
        s2 = aligned_encoded_vntr2[i]
        if s1 != s2:
            if s1 != '-' and s2 != '-':
                cost += dist_matrix[s1][s2]
            else:
                if allow_copy_change:
                    cost += 1.0
                else:
                    if s1 == '-':
                        cost += dist_matrix[s2][s2]
                    else:
                        cost += dist_matrix[s1][s1]
        i += 1
    return cost

def calculate_cost(alinged_vntrs: List[str], alphabet_to_motif: Dict[str, str]) -> int:
    total = 0
    i = 0
    while i < len(alinged_vntrs) - 1:
        total += _calculate_cost(alinged_vntrs[i], alinged_vntrs[i + 1], alphabet_to_motif)
        i += 1
    return total

def get_distance_matrix(symbol_to_motif: Dict[str, str], score: bool = False) -> Dict[str, Dict[str, float]]:
    """
    Edit distance between motifs; diagonal stores motif length.
    If score=True, returns scaled score = max_score * (1 - edit/max_len)
    """
    dist: Dict[str, Dict[str, float]] = {}
    max_score = 5.0
    syms = list(symbol_to_motif.keys())
    i = 0
    while i < len(syms):
        a = syms[i]
        dist[a] = {}
        j = 0
        while j < len(syms):
            b = syms[j]
            s1 = symbol_to_motif[a]
            s2 = symbol_to_motif[b]
            if a == b:
                dist[a][b] = float(len(s1))
            else:
                ed = float(get_levenshtein_distance(s1, s2))
                if score:
                    L = float(max(len(s1), len(s2)))
                    dist[a][b] = max_score * (1.0 - ed / L) if L > 0.0 else 0.0
                else:
                    dist[a][b] = ed
            j += 1
        i += 1
    return dist

def get_score_matrix(
    symbol_to_motif: Dict[str, str],
    match_score: int = 2,
    mismatch_score_for_edit_dist_of_1: int = -1,
    mismatch_score_for_edit_dist_greater_than_1: int = -2,
    gap_open_penalty: float = 1.5,
    gap_extension_penalty: float = 0.6
) -> Dict[str, Dict[str, float]]:
    """
    Build a score matrix based on motif edit distances.
    Top-level keys also include 'gap_open' and 'gap_extension'.
    """
    score_matrix: Dict[str, Dict[str, float]] = {}
    # store penalties at top level as separate entries
    score_matrix['gap_open'] = {'_': gap_open_penalty}
    score_matrix['gap_extension'] = {'_': gap_extension_penalty}

    syms = list(symbol_to_motif.keys())
    i = 0
    while i < len(syms):
        a = syms[i]
        score_matrix[a] = {}
        j = 0
        while j < len(syms):
            b = syms[j]
            s1 = symbol_to_motif[a]
            s2 = symbol_to_motif[b]
            if a == b:
                score_matrix[a][b] = float(match_score)
            else:
                ed = get_levenshtein_distance(s1, s2)
                edit_dist_cutoff = 1
                if abs(len(s1) - len(s2)) <= 1:
                    # integer floor of len(max)/30
                    extra = int(max(len(s1), len(s2)) // 30)
                    edit_dist_cutoff += extra
                if ed <= edit_dist_cutoff:
                    score_matrix[a][b] = float(mismatch_score_for_edit_dist_of_1)
                else:
                    score_matrix[a][b] = float(mismatch_score_for_edit_dist_greater_than_1)
            j += 1
        i += 1
    return score_matrix

def calculate_total_cost(alinged_vntrs: List[str], dist_matrix: Dict[str, Dict[str, float]]) -> float:
    total: float = 0.0
    i = 0
    while i < len(alinged_vntrs) - 1:
        total += calculate_cost_with_dist_matrix(alinged_vntrs[i], alinged_vntrs[i + 1], dist_matrix)
        i += 1
    return total

# --------------------------------------------------------------------
# Simulated annealing ordering (numpy-free)
# --------------------------------------------------------------------
def _all_index_pairs(n: int) -> List[Tuple[int, int]]:
    pairs: List[Tuple[int, int]] = []
    i = 0
    while i < n:
        j = i + 1
        while j < n:
            pairs.append((i, j))
            j += 1
        i += 1
    return pairs

def sort_by_simulated_annealing_optimized(
    seq_list: List[str],
    sample_ids: List[str],
    symbol_to_motif: Dict[str, str]
) -> Tuple[List[str], List[str]]:
    """
    Heuristic reordering to minimize total pairwise cost (neighbors).
    """
    dist_matrix = get_distance_matrix(symbol_to_motif, score=False)

    # copies of inputs
    initial_seq_list: List[str] = [s for s in seq_list]
    initial_sample_ids: List[str] = [s for s in sample_ids]

    initial_cost = calculate_total_cost(seq_list, dist_matrix)

    T: float = 1000.0
    DECAY: float = 0.9

    iteration = 0
    all_pairs = _all_index_pairs(len(seq_list))

    while True:
        iteration += 1
        if T <= 1.0e-2:
            break

        not_changed_count = 0

        # iterate over all pairs
        for (index_1, index_2) in all_pairs:
            # compute local neighborhood costs
            current_cost = 0.0
            after_cost = 0.0

            # Right neighbor of index_1
            if index_1 < len(seq_list) - 1:
                current_cost += calculate_cost_with_dist_matrix(seq_list[index_1], seq_list[index_1 + 1], dist_matrix)
                if index_1 + 1 == index_2:
                    after_cost += calculate_cost_with_dist_matrix(seq_list[index_2], seq_list[index_1], dist_matrix)
                else:
                    after_cost += calculate_cost_with_dist_matrix(seq_list[index_2], seq_list[index_1 + 1], dist_matrix)

            # Left neighbor of index_1
            if index_1 > 0:
                current_cost += calculate_cost_with_dist_matrix(seq_list[index_1], seq_list[index_1 - 1], dist_matrix)
                after_cost += calculate_cost_with_dist_matrix(seq_list[index_2], seq_list[index_1 - 1], dist_matrix)

            # Left neighbor of index_2
            current_cost += calculate_cost_with_dist_matrix(seq_list[index_2], seq_list[index_2 - 1], dist_matrix)
            if index_2 - 1 == index_1:
                after_cost += calculate_cost_with_dist_matrix(seq_list[index_1], seq_list[index_2], dist_matrix)
            else:
                after_cost += calculate_cost_with_dist_matrix(seq_list[index_1], seq_list[index_2 - 1], dist_matrix)

            # Right neighbor of index_2
            if index_2 < len(seq_list) - 1:
                current_cost += calculate_cost_with_dist_matrix(seq_list[index_2], seq_list[index_2 + 1], dist_matrix)
                after_cost += calculate_cost_with_dist_matrix(seq_list[index_1], seq_list[index_2 + 1], dist_matrix)

            # acceptance rule
            if after_cost == current_cost:
                continue
            elif after_cost < current_cost:
                # swap
                tmp = seq_list[index_1]; seq_list[index_1] = seq_list[index_2]; seq_list[index_2] = tmp
                tmp2 = sample_ids[index_1]; sample_ids[index_1] = sample_ids[index_2]; sample_ids[index_2] = tmp2
            else:
                # probabilistic accept
                prob = math.exp(-(after_cost - current_cost) * 10.0 / T)
                if prob > random.random():
                    tmp = seq_list[index_1]; seq_list[index_1] = seq_list[index_2]; seq_list[index_2] = tmp
                    tmp2 = sample_ids[index_1]; sample_ids[index_1] = sample_ids[index_2]; sample_ids[index_2] = tmp2
                else:
                    not_changed_count += 1

        T *= DECAY

    after_cost = calculate_total_cost(seq_list, dist_matrix)
    if initial_cost < after_cost:
        return initial_sample_ids, initial_seq_list
    return sample_ids, seq_list

# --------------------------------------------------------------------
# Padding & progress bar
# --------------------------------------------------------------------
def add_padding(encoded_trs: List[str]) -> List[str]:
    """
    Right-pad encoded strings with '-' to the max length.
    Safe for None values and avoids string * int.
    """
    # sanitize inputs and find max length
    clean: List[str] = []
    max_len = 0
    i = 0
    while i < len(encoded_trs):
        s = encoded_trs[i]
        if s is None:
            s = ""
        clean.append(s)
        if len(s) > max_len:
            max_len = len(s)
        i += 1

    # pad each string manually
    out: List[str] = []
    i = 0
    while i < len(clean):
        s = clean[i]
        pad = max_len - len(s)
        if pad < 0:
            pad = 0
        dashes = ""
        j = 0
        while j < pad:
            dashes = dashes + "-"
            j += 1
        out.append(s + dashes)
        i += 1
    return out


def print_progress_bar(
    iteration: int,
    total: int,
    prefix: str = '',
    suffix: str = '',
    decimals: int = 1,
    length: int = 100,
    fill: str = '█',
    print_end: str = "\r"
) -> None:
    # If total is zero, just draw an empty bar
    if total <= 0:
        bar = "-" * length
        print(prefix + " |" + bar + "| 0% " + suffix)
        return

    # Percent with manual rounding to `decimals`
    perc = 100.0 * (float(iteration) / float(total))
    if decimals <= 0:
        percent_str = str(int(perc + 0.5))
    else:
        scale = 1
        i = 0
        while i < decimals:
            scale *= 10
            i += 1
        val = int(perc * scale + 0.5)
        intpart = val // scale
        frac = val % scale
        frac_str = str(frac)
        while len(frac_str) < decimals:
            frac_str = "0" + frac_str
        percent_str = str(intpart) + "." + frac_str

    # Build the bar (avoid any slicing tricks)
    filled_len = int(length * iteration // total)
    if filled_len < 0:
        filled_len = 0
    if filled_len > length:
        filled_len = length
    left = ""
    i = 0
    while i < filled_len:
        left = left + fill
        i += 1
    right = ""
    i = 0
    while i < (length - filled_len):
        right = right + "-"
        i += 1
    bar = left + right

    print(prefix + " |" + bar + "| " + percent_str + "% " + suffix)


# --------------------------------------------------------------------
# Region & population utilities
# --------------------------------------------------------------------
def get_motif_marks(
    sample_ids: List[str],
    decomposed_trs: List[List[str]],
    region_prediction_file: str
) -> Dict[str, str]:
    """
    Parse region-prediction file:
      >sample_id
      region1,start,end \t region2,start,end ...
    Returns dict: sample_id -> motif-mark string of same length as decomposed_tr.
    'I' for intron overlap, 'X' otherwise.
    """
    region_prediction: Dict[str, List[Tuple[str, int, int]]] = {}

    with open(region_prediction_file, 'r') as f:
        current_id = ""
        for raw in f:
            line = raw.strip()
            if not line:
                continue
            if line.startswith('>'):
                current_id = line[1:]
            else:
                if current_id == "":
                    continue
                region_prediction[current_id] = []
                parts = line.split('\t')
                for region in parts:
                    seg = region.split(',')
                    if len(seg) == 3:
                        name = seg[0]
                        start = int(seg[1])
                        end = int(seg[2])
                        region_prediction[current_id].append((name, start, end))

    motif_marks: Dict[str, str] = {}
    z = 0
    while z < len(sample_ids):
        sid = sample_ids[z]
        tr = decomposed_trs[z]
        motif_mark = ""
        cumulative = 0

        if sid not in region_prediction:
            print("Sample " + sid + " is not in the region prediction file")
            z += 1
            continue

        k = 0
        while k < len(tr):
            motif_seq = tr[k]
            motif_start = cumulative
            motif_end = cumulative + len(motif_seq)
            # any overlap with an intron tag => 'I'
            mark = 'X'
            for (name, start, end) in region_prediction[sid]:
                if name == "intron":
                    if (start <= motif_start < end) or (start <= motif_end < end) or (motif_start <= start <= end <= motif_end):
                        mark = 'I'
                        break
            motif_mark += mark
            cumulative = motif_end
            k += 1

        motif_marks[sid] = motif_mark
        if len(motif_mark) != len(tr):
            raise Exception("The length of the motif mark is not equal to the number of motifs")
        z += 1

    return motif_marks

def get_sample_to_population(
    population_data: str,
    sep: str = '\t',
    sample_index: int = 0,
    population_index: int = 5
) -> Dict[str, str]:
    """
    Parse sample → population mapping from a delimited file.
    """
    m: Dict[str, str] = {}
    with open(population_data, "r") as f:
        for raw in f:
            line = raw.strip()
            if not line:
                continue
            cols = line.split(sep)
            if len(cols) <= max(sample_index, population_index):
                continue
            sample = cols[sample_index]
            population = cols[population_index]
            m[sample] = population
    return m

# --------------------------------------------------------------------
# Tiny self-test
# --------------------------------------------------------------------
if __name__ == "__main__":
    # quick checks
    assert is_valid_sequence("ACGT")
    assert not is_valid_sequence("ACGX")

    # Levenshtein sanity
    assert get_levenshtein_distance("kitten", "sitting") == 3

    # padding
    padded = add_padding(["ab", "a--", "abcd"])
    for p in padded:
        print(p)
