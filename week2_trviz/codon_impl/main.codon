# codon_impl/main.codon
# Codon driver: Decompose → Encode → Align → (optional) Rearrange
# Writes TSV for Python visualizer; no plotting here.

from typing import List, Tuple, Dict

from decomposer import Decomposer
from motif_encoder import MotifEncoder
from motif_aligner import MotifAligner
from utils import sort, add_padding, get_motif_marks, print_progress_bar

def _right_pad_local(seq: List[str]) -> List[str]:
    clean: List[str] = []
    max_len = 0
    i = 0
    while i < len(seq):
        s = seq[i]
        if s is None:
            s = ""
        clean.append(s)
        if len(s) > max_len:
            max_len = len(s)
        i += 1
    out: List[str] = []
    i = 0
    while i < len(clean):
        s = clean[i]
        pad = max_len - len(s)
        if pad < 0:
            pad = 0
        d = ""
        j = 0
        while j < pad:
            d = d + "-"
            j += 1
        out.append(s + d)
        i += 1
    return out

def _sanitize_ascii(s: str) -> str:
    # Keep printable ASCII '!'..'~'; replace others with 'X'
    out = ""
    i = 0
    while i < len(s):
        ch = s[i]
        o = ord(ch)
        out = out + (ch if (o >= 33 and o <= 126) else "X")
        i += 1
    return out

def _copy_clean_list(lst: List[str]) -> List[str]:
    # Return a fresh list of safe strings. Avoids Codon bugs on list repr/aliasing.
    out: List[str] = []
    i = 0
    while i < len(lst):
        s = lst[i]
        if s is None:
            s = ""
        out.append(_sanitize_ascii(s))
        i += 1
    return out

def _debug_print_lengths(title: str, seqs: List[str]) -> None:
    # Print only counts/lengths (never the raw list repr)
    print(title + " N=" + str(len(seqs)))
    i = 0
    while i < len(seqs):
        # Avoid printing whole strings; just the length
        print("  row " + str(i) + " len " + str(len(seqs[i])))
        i += 1




class TandemRepeatVizWorker:
    def __init__(self):
        self.decomposer = Decomposer()
        self.motif_encoder = MotifEncoder()
        self.motif_aligner = MotifAligner()

    def generate_trdata(
        self,
        tr_id: str,
        sample_ids: List[str],
        tr_sequences: List[str],
        motifs: List[str],

        # pipeline toggles / options
        skip_alignment: bool = False,
        rearrangement_method: str = "clustering",   # {'clustering','name','motif_count','simulated_annealing','manually','None'}
        sample_order_file: str = "",
        output_dir: str = "./outputs",
        region_prediction_file: str = "",

        # kept for API parity (ignored for Codon driver)
        figure_size: Tuple[int, int] = (0, 0),
        motif_map_size: Tuple[int, int] = (0, 0),
        output_name: str = "",
        dpi: int = 300,
        hide_xticks: bool = False,
        hide_yticks: bool = False,
        hide_dendrogram: bool = True,
        sample_to_label: Dict[str, str] = {},
        allele_as_row: bool = True,
        xlabel_size: int = 8,
        ylabel_size: int = 8,
        xlabel_rotation: int = 0,
        ylabel_rotation: int = 0,
        private_motif_color: str = "black",
        frame_on: Dict[str, bool] = {},
        show_figure: bool = False,
        style: str = "seattle",
        no_edge: bool = False,
        color_palette: str = "",
        colormap: str = "",
        motif_style: str = "box",
        xtick_step: int = 1,
        ytick_step: int = 1,
        xtick_offset: int = 0,
        ytick_offset: int = 0,
        title: str = "",
        xlabel: str = "",
        ylabel: str = "",
        colored_motifs: List[str] = [],
        verbose: bool = True
    ) -> Tuple[List[str], List[str]]:

        if len(sample_ids) != len(tr_sequences):
            raise ValueError("The number of sample IDs and the number of sequences are different.")

        # manual ordering guard
        if (sample_order_file != "") or (rearrangement_method == "manually"):
            rearrangement_method = "manually"
            if sample_order_file == "":
                raise ValueError("Please specify the sample order file for manual rearrangement.")

        if style != "waterfall" and style != "seattle":
            raise ValueError("The style should be either 'waterfall' or 'seattle'.")

        if verbose:
            print("ID:", tr_id)
            print("Motifs:", motifs)
            print("Loaded", len(tr_sequences), "tandem repeat sequences")
            print("Decomposing TR sequences")
            

        # 1) Decomposition
        decomposed_trs: List[List[str]] = []
        i = 0
        while i < len(tr_sequences):
            if verbose:
                print_progress_bar(i + 1, len(tr_sequences))
            decomposed_trs.append(self.decomposer.decompose(tr_sequences[i], motifs))
            i += 1

        # optional refinement
        decomposed_trs = self.decomposer.refine(decomposed_trs)

        # 2) Encoding (writes <tr_id>_motif_map.txt)
        if verbose:
            print("Encoding")
        motif_map_path = output_dir + "/" + tr_id + "_motif_map.txt"

        encoded_trs_raw: List[str] = self.motif_encoder.encode(
            decomposed_trs,
            motif_map_file=motif_map_path,
            auto=True
        )

        # CRITICAL: make a fresh, sanitized copy before any access/print
        encoded_trs: List[str] = _copy_clean_list(encoded_trs_raw)

        if verbose:
            _debug_print_lengths("Encoded TRs", encoded_trs)

        # 'waterfall' style forces a specific flow
        if style == "waterfall":
            skip_alignment = True
            rearrangement_method = "motif_count"
            allele_as_row = True

        # 3) Alignment
        if skip_alignment:
          if verbose:
              print("Skip alignment step")
              print("Encoded TRs (pre-pad):")
              for s in encoded_trs:
                  print(s)
          aligned_trs = _right_pad_local(encoded_trs)
          if verbose:
              print("Aligned TRs (padded):")
              for s in aligned_trs:
                  print(s)
          sorted_sample_ids = sample_ids[:]

        else:
            if verbose:
                print("Alignment")
            score_matrix = self.motif_encoder.score_matrix  # int-based matrix from MotifEncoder
            sorted_sample_ids, aligned_trs = self.motif_aligner.align(
                sample_ids,
                encoded_trs,
                tr_id,
                score_matrix=score_matrix,
                output_dir=output_dir,
                tool="star"
            )

        # 4) Optional rearrangement (skip visual-only 'clustering')
        if (rearrangement_method is not None) and (rearrangement_method != "clustering") and (rearrangement_method != "None"):
            sorted_sample_ids, aligned_trs = sort(
                aligned_trs,
                sorted_sample_ids,
                self.motif_encoder.symbol_to_motif,
                sample_order_file,
                rearrangement_method
            )

        # optional motif marks (introns etc.)
        if region_prediction_file != "":
            try:
                motif_marks = get_motif_marks(sample_ids, decomposed_trs, region_prediction_file)
                fmm = open(output_dir + "/" + tr_id + "_motif_marks.txt", "w")
                k = 0
                while k < len(sorted_sample_ids):
                    sid = sorted_sample_ids[k]
                    if sid in motif_marks:
                        fmm.write(sid + "\t" + motif_marks[sid] + "\n")
                    k += 1
                fmm.close()
            except Exception as e:
                print("Warning: failed to write motif marks:", e)

        # 5) Write aligned TSV for Python visualizer
        aligned_path = (output_dir + "/" + tr_id + ".aligned.txt") if output_name == "" else output_name
        try:
            f = open(aligned_path, "w")
            k = 0
            while k < len(sorted_sample_ids):
                f.write(sorted_sample_ids[k] + "\t" + aligned_trs[k] + "\n")
                k += 1
            f.close()
            if verbose:
                print("Wrote:", aligned_path)
                print("Wrote:", motif_map_path)
        except Exception as e:
            raise ValueError(
                "Failed to write aligned TSV. Make sure the output directory exists: " +
                output_dir + " (mkdir -p " + output_dir + "). Underlying error: " + str(e)
            )

        return sorted_sample_ids, aligned_trs

# -------------------------
# Tiny demo / self-check
# -------------------------
if __name__ == "__main__":
    worker = TandemRepeatVizWorker()
    tr_id = "TEST_TR"
    sample_ids = ["s1", "s2", "s3"]
    tr_sequences = [
        "ACCTTGACCTTGACCTTC",
        "ACCTTGACCTTCACCTTC",
        "ACCTTCACCTTGACCTTC",
    ]
    motifs = ["ACCTTG", "ACCTTC"]

    # Ensure the output folder exists BEFORE running (Codon has no makedirs):
    #   mkdir -p outputs
    ids_out, aln_out = worker.generate_trdata(
        tr_id=tr_id,
        sample_ids=sample_ids,
        tr_sequences=tr_sequences,
        motifs=motifs,
        output_dir="./outputs",
        verbose=True
    )
    print(ids_out)
    for row in aln_out:
        print(row)
    print("Now run:  python pyviz/viz_trplot.py")
