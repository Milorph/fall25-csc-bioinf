# week4/aligners.codon
import sys

MATCH = 3
MISMATCH = -3
GAP = -2
GAP_OPEN = -5
GAP_EXTEND = -1


def read_first_fasta(path: str) -> str:
    seq = ""
    for line in open(path):
        line = line.strip()
        if line and not line.startswith(">"):
            seq += line
    return seq


def global_align(a: str, b: str) -> int:
    n, m = len(a), len(b)
    dp = [[0] * (m + 1) for _ in range(n + 1)]
    for i in range(1, n + 1):
        dp[i][0] = i * GAP
    for j in range(1, m + 1):
        dp[0][j] = j * GAP
    for i in range(1, n + 1):
        for j in range(1, m + 1):
            diag = dp[i - 1][j - 1] + (MATCH if a[i - 1] == b[j - 1] else MISMATCH)
            up = dp[i - 1][j] + GAP
            left = dp[i][j - 1] + GAP
            dp[i][j] = max(diag, up, left)
    return dp[n][m]


def local_align(a: str, b: str) -> int:
    n, m = len(a), len(b)
    dp = [[0] * (m + 1) for _ in range(n + 1)]
    best = 0
    for i in range(1, n + 1):
        for j in range(1, m + 1):
            diag = dp[i - 1][j - 1] + (MATCH if a[i - 1] == b[j - 1] else MISMATCH)
            up = dp[i - 1][j] + GAP
            left = dp[i][j - 1] + GAP
            dp[i][j] = max(0, diag, up, left)
            if dp[i][j] > best:
                best = dp[i][j]
    return best


def semi_global_align(a: str, b: str) -> int:
    n, m = len(a), len(b)
    dp = [[0] * (m + 1) for _ in range(n + 1)]
    for i in range(1, n + 1):
        dp[i][0] = i * GAP
    for i in range(1, n + 1):
        for j in range(1, m + 1):
            diag = dp[i - 1][j - 1] + (MATCH if a[i - 1] == b[j - 1] else MISMATCH)
            up = dp[i - 1][j] + GAP
            left = dp[i][j - 1] + GAP
            dp[i][j] = max(diag, up, left)
    best = -10**9
    for j in range(m + 1):
        if dp[n][j] > best:
            best = dp[n][j]
    return best


def affine_global_align(a: str, b: str) -> int:
    n, m = len(a), len(b)
    NEG_INF = -10**9
    M = [[NEG_INF] * (m + 1) for _ in range(n + 1)]
    X = [[NEG_INF] * (m + 1) for _ in range(n + 1)]
    Y = [[NEG_INF] * (m + 1) for _ in range(n + 1)]
    M[0][0] = 0
    for i in range(1, n + 1):
        X[i][0] = GAP_OPEN + (i - 1) * GAP_EXTEND
    for j in range(1, m + 1):
        Y[0][j] = GAP_OPEN + (j - 1) * GAP_EXTEND
    for i in range(1, n + 1):
        for j in range(1, m + 1):
            match = MATCH if a[i - 1] == b[j - 1] else MISMATCH
            M[i][j] = max(
                M[i - 1][j - 1] + match,
                X[i - 1][j - 1] + match,
                Y[i - 1][j - 1] + match,
            )
            X[i][j] = max(M[i - 1][j] + GAP_OPEN + GAP_EXTEND, X[i - 1][j] + GAP_EXTEND)
            Y[i][j] = max(M[i][j - 1] + GAP_OPEN + GAP_EXTEND, Y[i][j - 1] + GAP_EXTEND)
    return max(M[n][m], X[n][m], Y[n][m])


def main():
    args = sys.argv
    # Example: codon run week4/aligners.codon -- --method global --a q1.fa --b t1.fa
    method = ""
    path_a = ""
    path_b = ""
    for i in range(1, len(args)):
        if args[i] == "--method" and i + 1 < len(args):
            method = args[i + 1]
        elif args[i] == "--a" and i + 1 < len(args):
            path_a = args[i + 1]
        elif args[i] == "--b" and i + 1 < len(args):
            path_b = args[i + 1]

    if method == "" or path_a == "" or path_b == "":
        print("Usage: --method <global/local/semi-global/affine-global> --a <file> --b <file>")
        sys.exit(1)

    A = read_first_fasta(path_a)
    B = read_first_fasta(path_b)

    if method == "global":
        print(global_align(A, B))
    elif method == "local":
        print(local_align(A, B))
    elif method == "semi-global":
        print(semi_global_align(A, B))
    elif method == "affine-global":
        print(affine_global_align(A, B))
    else:
        print("Invalid method name:", method)
        sys.exit(1)


if __name__ == "__main__":
    main()
