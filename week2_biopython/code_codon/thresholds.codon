from typing import Any, Dict, List, Optional
import math
from matrix import PositionSpecificScoringMatrix
from motif import Motif

Background = Dict[str, float]

def _log2(x: float) -> float:
    return math.log(x) / math.log(2.0)

def _exp2(x: float) -> float:
    return math.exp(x * math.log(2.0))

class ScoreDistribution:
    min_score: float
    interval: float
    n_points: int
    step: float
    ic: float
    mo_density: List[float]
    bg_density: List[float]

    def __init__(
        self,
        motif: Optional[Any] = None,
        precision: int = 10**3,
        pssm: Optional[PositionSpecificScoringMatrix] = None,
        background: Optional[Background] = None
    ) -> None:
        if pssm is None:
            if motif is None:
                raise ValueError("Provide either motif or pssm")
            resolved_bg: Background = motif.get_background()
            p: PositionSpecificScoringMatrix = motif.get_pssm()
            ic_vals: List[float] = motif.get_relative_entropy()
            ic_total: float = 0.0
            i: int = 0
            while i < len(ic_vals):
                ic_total += ic_vals[i]
                i += 1
            self.ic = ic_total
        else:
            p = pssm
            if background is None:
                resolved_bg = {}
                one: float = 1.0 / float(len(p.alphabet))
                i: int = 0
                while i < len(p.alphabet):
                    resolved_bg[p.alphabet[i]] = one
                    i += 1
            else:
                resolved_bg = {}
                tot: float = 0.0
                for L in p.alphabet:
                    if L in background:
                        tot += background[L]
                if tot > 0.0:
                    for L in p.alphabet:
                        resolved_bg[L] = background[L] / tot
                else:
                    one = 1.0 / float(len(p.alphabet))
                    for L in p.alphabet:
                        resolved_bg[L] = one
            self.ic = p.mean(resolved_bg)

        # range/discretization
        self.min_score = 0.0
        if p.min < 0.0:
            self.min_score = p.min
        pmax: float = p.max if p.max > 0.0 else 0.0
        self.interval = pmax - self.min_score

        self.n_points = max(2, precision * p.length)
        if self.interval <= 0.0:
            self.step = 1.0
        else:
            self.step = self.interval / float(self.n_points - 1)

        self.mo_density = [0.0] * self.n_points
        self.bg_density = [0.0] * self.n_points
        origin: int = self._add(0, -self._index_diff(self.min_score, 0.0))
        self.mo_density[origin] = 1.0
        self.bg_density[origin] = 1.0

        pos: int = 0
        while pos < p.length:
            mo_new: List[float] = [0.0] * self.n_points
            bg_new: List[float] = [0.0] * self.n_points

            li: int = 0
            while li < len(p.alphabet):
                L: str = p.alphabet[li]
                score: float = p.get_value(L, pos)
                bgp: float = resolved_bg[L]
                mo_prob: float = _exp2(score) * bgp
                shift: int = self._index_diff(score, 0.0)

                i: int = 0
                while i < self.n_points:
                    idx: int = self._add(i, shift)
                    mo_new[idx] += self.mo_density[i] * mo_prob
                    bg_new[idx] += self.bg_density[i] * bgp
                    i += 1
                li += 1

            self.mo_density = mo_new
            self.bg_density = bg_new
            pos += 1

    def _index_diff(self, x: float, y: float = 0.0) -> int:
        return int(((x - y) + 0.5 * self.step) // self.step)

    def _add(self, i: int, j: int) -> int:
        s: int = i + j
        if s < 0:
            return 0
        if s >= self.n_points:
            return self.n_points - 1
        return s

    def threshold_fpr(self, fpr: float) -> float:
        if fpr <= 0.0:
            return self.min_score + (self.n_points - 1) * self.step
        if fpr >= 1.0:
            return self.min_score
        i: int = self.n_points
        prob: float = 0.0
        while i > 0 and prob < fpr:
            i -= 1
            prob += self.bg_density[i]
        return self.min_score + i * self.step

    def threshold_fnr(self, fnr: float) -> float:
        if fnr <= 0.0:
            return self.min_score
        if fnr >= 1.0:
            return self.min_score + (self.n_points - 1) * self.step
        i: int = -1
        prob: float = 0.0
        while (i + 1) < self.n_points and prob < fnr:
            i += 1
            prob += self.mo_density[i]
        return self.min_score + i * self.step

    def threshold_balanced(self, rate_proportion: float = 1.0, return_rate: bool = False):
        i: int = self.n_points
        fpr: float = 0.0
        fnr: float = 1.0
        while i > 0 and (fpr * rate_proportion) < fnr:
            i -= 1
            fpr += self.bg_density[i]
            fnr -= self.mo_density[i]
        thresh: float = self.min_score + i * self.step
        if return_rate:
            return (thresh, fpr)
        return thresh

    def threshold_patser(self) -> float:
        target_fpr: float = 2.0 ** (-self.ic)
        return self.threshold_fpr(target_fpr)
