__author__ = "Patrick Kunzmann"
__all__ = ["neighbor_joining"]

from python import numpy as np
from numpy import ndarray, array, zeros, ones, full, float32, float64, int32, uint8, uint32, asarray
from typing import List

from tree import Tree, TreeNode

MAX_FLOAT: float32 = float32(3.4028235e+38)


def neighbor_joining(distances: ndarray) -> Tree:
    distances = asarray(distances).astype(float32, copy=True)

    # Symmetry check
    is_symmetric = True
    n0 = distances.shape[0]
    n1 = distances.shape[1]
    for i in range(n0):
        for j in range(n1):
            if abs(distances[i, j] - distances[j, i]) >= float32(1e-8):
                is_symmetric = False
                break
        if not is_symmetric:
            break
    if n0 != n1 or not is_symmetric:
        raise ValueError("Distance matrix must be symmetric")

    # NaN check
    has_nan = False
    for i in range(n0):
        for j in range(n1):
            if distances[i, j] != distances[i, j]:
                has_nan = True
                break
        if has_nan:
            break
    if has_nan:
        raise ValueError("Distance matrix contains NaN values")

    # Inf check
    has_inf = False
    for i in range(n0):
        for j in range(n1):
            if distances[i, j] >= MAX_FLOAT:
                has_inf = True
                break
        if has_inf:
            break
    if has_inf:
        raise ValueError("Distance matrix contains infinity")

    # Other checks
    if n0 < 4:
        raise ValueError("At least 4 nodes are required")
    has_negative = False
    for i in range(n0):
        for j in range(n1):
            if distances[i, j] < float32(0.0):
                has_negative = True
                break
        if has_negative:
            break
    if has_negative:
        raise ValueError("Distances must be positive")

    n = n0

    # NumPy object array of nodes (kept like your classmate’s style)
    nodes = array([TreeNode(index=i) for i in range(n)])
    is_clustered = full(n, False, dtype=uint8)
    divergence = zeros(n, dtype=float32)
    corr_distances = zeros((n, n), dtype=float32)
    distances_v = distances.astype(float32, copy=True)

    n_rem_nodes = n
    for i in range(n):
        if is_clustered[i]:
            n_rem_nodes -= 1

    while True:
        # 1) divergence
        for i in range(n):
            if is_clustered[i]:
                continue
            dist_sum: float32 = float32(0.0)
            for k in range(n):
                if not is_clustered[k]:
                    dist_sum += distances_v[i, k]
            divergence[i] = dist_sum

        # 2) corrected distances
        for i in range(n):
            if is_clustered[i]:
                continue
            for j in range(i):
                if is_clustered[j]:
                    continue
                corr_distances[i, j] = float32(n_rem_nodes - 2) * distances_v[i, j] - divergence[i] - divergence[j]

        # 3) argmin
        dist_min: float32 = MAX_FLOAT
        i_min, j_min = -1, -1
        for i in range(n):
            if is_clustered[i]:
                continue
            for j in range(i):
                if is_clustered[j]:
                    continue
                dist = corr_distances[i, j]
                if dist < dist_min:
                    dist_min = dist
                    i_min, j_min = i, j

        if i_min == -1 or j_min == -1:
            break

        # 4) limb lengths
        node_dist_i: float = float(
            float32(0.5)
            * (distances_v[i_min, j_min] + (float32(1.0) / float32(n_rem_nodes - 2)) * (divergence[i_min] - divergence[j_min]))
        )
        node_dist_j: float = float(
            float32(0.5)
            * (distances_v[i_min, j_min] + (float32(1.0) / float32(n_rem_nodes - 2)) * (divergence[j_min] - divergence[i_min]))
        )

        # 5) merge
        if n_rem_nodes > 3:
            node_i: TreeNode = nodes[i_min]
            node_j: TreeNode = nodes[j_min]
            children_list: List[TreeNode] = [node_i, node_j]
            distances_list: List[float] = [node_dist_i, node_dist_j]
            nodes[i_min] = TreeNode(children_list, distances_list)
            # mark retired slot as None like your classmate’s code
            nodes[j_min] = None
            is_clustered[j_min] = True
        else:
            # final join
            is_clustered[i_min] = True
            is_clustered[j_min] = True
            k = -1
            for idx in range(n):
                if not is_clustered[idx]:
                    k = idx
                    break
            if k == -1:
                raise ValueError("Could not find third node for root")
            node_k: TreeNode = nodes[k]
            node_dist_k: float = float(
                float32(0.5) * (distances_v[i_min, k] + distances_v[j_min, k] - distances_v[i_min, j_min])
            )
            children_list: List[TreeNode] = [nodes[i_min], nodes[j_min], node_k]
            distances_list: List[float] = [node_dist_i, node_dist_j, node_dist_k]
            root = TreeNode(children_list, distances_list)
            return Tree(root)

        # 6) update distances
        for k in range(n):
            if (not is_clustered[k]) and k != i_min:
                dist = float32(0.5) * (
                    distances_v[i_min, k] + distances_v[j_min, k] - distances_v[i_min, j_min]
                )
                distances_v[i_min, k] = dist
                distances_v[k, i_min] = dist

        # 7) remaining count
        n_rem_nodes = 0
        for t in range(n):
            if not is_clustered[t]:
                n_rem_nodes += 1

    # fallback: return remaining
    root_idx = -1
    for i in range(n):
        if not is_clustered[i]:
            root_idx = i
            break
    if root_idx == -1:
        raise ValueError("Could not find root node")
    return Tree(nodes[root_idx])
